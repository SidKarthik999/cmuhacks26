{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cmuhacks26/shared/schemas/note_event.schema.json",
  "title": "NoteEvent",
  "description": "Discrete note from Task 8 (Person B). Frontend can render this JSON directly; MIDI export uses the same events.",
  "type": "object",
  "version": 1,
  "required": ["pitch_midi", "note_name", "start_ms", "duration_ms", "confidence"],
  "properties": {
    "pitch_midi": { "type": "integer" },
    "note_name": { "type": "string" },
    "start_ms": { "type": "number" },
    "duration_ms": { "type": "number" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "velocity": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "additionalProperties": false
}
