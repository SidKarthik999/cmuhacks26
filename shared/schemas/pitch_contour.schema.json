{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cmuhacks26/shared/schemas/pitch_contour.schema.json",
  "title": "PitchContour",
  "description": "Shared pitch-tracking output (Task 8). Owned by Person B. Person C Task 5 consumes extract_pitch_contour().",
  "type": "object",
  "version": 1,
  "required": ["sample_rate", "hop_ms", "points"],
  "properties": {
    "sample_rate": {
      "type": "integer",
      "minimum": 1
    },
    "hop_ms": {
      "type": "number",
      "minimum": 0
    },
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["time_ms", "pitch_hz", "confidence"],
        "properties": {
          "time_ms": { "type": "number" },
          "pitch_hz": {
            "type": ["number", "null"],
            "description": "Fundamental frequency in Hz, or null if unvoiced."
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
