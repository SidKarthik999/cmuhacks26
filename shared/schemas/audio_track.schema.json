{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cmuhacks26.local/schemas/audio_track.schema.json",
  "title": "AudioTrack",
  "description": "Task 1 — Person A owns. Per-participant raw audio track exposed for downstream processing (Task 2+).",
  "version": 1,
  "type": "object",
  "required": [
    "track_id",
    "participant_id",
    "room_id",
    "sample_rate",
    "channels",
    "format",
    "is_remote"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "track_id": {
      "type": "string",
      "description": "Stable ID for this media track within the room session."
    },
    "participant_id": {
      "type": "string"
    },
    "room_id": {
      "type": "string"
    },
    "sample_rate": {
      "type": "integer",
      "enum": [16000, 24000, 44100, 48000]
    },
    "channels": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "format": {
      "type": "string",
      "enum": ["pcm_f32", "pcm_s16", "opus"],
      "description": "Encoding of chunks delivered over the platform→audio-backend boundary."
    },
    "is_remote": {
      "type": "boolean",
      "description": "true if this track belongs to another participant; false for local mic."
    },
    "media_stream_track_id": {
      "type": ["string", "null"],
      "description": "Browser MediaStreamTrack.id when available in-client."
    }
  },
  "additionalProperties": false
}
